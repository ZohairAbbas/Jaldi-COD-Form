# Shopify Configuration
SHOPIFY_API_KEY=your_shopify_api_key_here
SHOPIFY_API_SECRET=your_shopify_api_secret_here
SCOPES=write_draft_orders,write_orders,read_products,read_price_rules,read_discounts

# App URLs (replace with your actual domain)
SHOPIFY_APP_URL=https://jaldicod.yourdomain.com
HOST=https://jaldicod.yourdomain.com

# App Handle (the URL-friendly name from Shopify Partner Dashboard)
# Example: if your app URL is admin.shopify.com/store/xxx/apps/my-app-name
# then SHOPIFY_APP_HANDLE=my-app-name
SHOPIFY_APP_HANDLE=jaldi-cod-form

# Database
DATABASE_URL=postgresql://jaldicod_user:your_secure_password_here@localhost:5432/jaldicod

# Session Storage
SESSION_SECRET=generate_random_32_character_string_here

# Node Environment
NODE_ENV=production

# Port
# Must match the nginx proxy_pass target for this app. ecosystem.config.cjs
# reads this value, so changing it here moves both the app and the cron worker.
PORT=3001

# Cron Worker
# Leave APP_URL unset to have the worker follow PORT automatically (recommended).
# Only set it explicitly if the worker runs on a different host than the app.
# APP_URL=http://localhost:3001
# Must be identical to the CRON_SECRET the app validates, or every job 401s.
# REQUIRED: when unset, the app rejects every cron request rather than allowing
# them through. The worker's startup preflight reports this as a 401.
CRON_SECRET=generate_random_32_character_string_here

# Storefront app-proxy authentication
#   log     (default) — verify the Shopify signature, record failures, and let
#                       the request through. Use this to observe real traffic
#                       before enforcing.
#   enforce           — reject unsigned requests with 401.
# Roll out as: deploy with `log`, watch for [proxy-auth] warnings for 12-24h,
# then switch to `enforce` and restart. Cron endpoints are unaffected — they
# always enforce X-Cron-Secret regardless of this setting.
PROXY_AUTH_MODE=log

# Optional: Custom shop domain for development
# SHOP_CUSTOM_DOMAIN=your-shop.myshopify.com

# WhatsApp (Meta Cloud API)
# Meta app secret, used to verify X-Hub-Signature-256 on incoming webhooks.
# REQUIRED: when unset, every WhatsApp webhook is rejected rather than trusted.
# Webhooks reach this app via Courierify, which forwards the raw body and the
# original signature header. All apps in the suite share one Meta app, so this
# must be the SAME value as Courierify's WA_CLOUD_APP_SECRET.
WA_CLOUD_APP_SECRET=your_meta_app_secret_here

# Mantle Billing
MANTLE_APP_ID=your_mantle_app_id_here
MANTLE_API_KEY=your_mantle_api_key_here

# Mixpanel (includes session recording)
MIXPANEL_TOKEN=your_mixpanel_project_token_here
