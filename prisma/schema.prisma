generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model Shop {
  id            String      @id @default(cuid())
  shopifyDomain String      @unique
  accessToken   String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  formConfig    FormConfig?
  orders        Order[]
  settings      Settings?
}

model Settings {
  id                 String   @id @default(cuid())
  shopId             String   @unique
  formMode           String   @default("popup")
  enablePopup        Boolean  @default(true)
  enableEmbedded     Boolean  @default(false)
  buttonText         String   @default("Buy with Cash on Delivery")
  buttonPosition     String   @default("bottom")
  buttonBgColor      String   @default("rgba(0,0,0,1)")
  buttonTextColor    String   @default("rgba(255,255,255,1)")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  buttonAnimation    String   @default("none")
  buttonBorderColor  String   @default("#000000")
  buttonBorderRadius Int      @default(4)
  buttonBorderWidth  Int      @default(0)
  buttonFontSize     Int      @default(16)
  buttonIcon         String   @default("cart")
  buttonShadow       Int      @default(4)
  orderCreationMode  String   @default("checkout")
  shop               Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model FormConfig {
  id                     String   @id @default(cuid())
  shopId                 String   @unique
  formTitle              String   @default("CASH ON DELIVERY")
  textColor              String   @default("rgba(0,0,0,1)")
  backgroundColor        String   @default("rgba(255,255,255,1)")
  fontSize               Int      @default(14)
  borderRadius           Int      @default(8)
  borderWidth            Int      @default(1)
  borderColor            String   @default("rgba(0,0,0,0.1)")
  shadowIntensity        Int      @default(5)
  sections               Json     @default("[]")
  fields                 Json     @default("[]")
  requiredFieldErrorText String   @default("This field is required.")
  invalidFieldErrorText  String   @default("Enter a valid value.")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  shop                   Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model Order {
  id                 String   @id @default(cuid())
  shopId             String
  shopifyOrderId     String?  @unique
  shopifyOrderNumber String?
  firstName          String
  lastName           String
  email              String?
  phone              String
  address            String
  address2           String?
  city               String
  province           String
  postalCode         String?
  country            String   @default("Pakistan")
  subtotal           Float
  shipping           Float    @default(0)
  total              Float
  customFields       Json     @default("{}")
  items              Json
  status             String   @default("pending")
  checkoutUrl        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  shop               Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([status])
  @@index([createdAt])
}
