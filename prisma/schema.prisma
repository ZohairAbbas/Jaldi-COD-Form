generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model Shop {
  id                 String          @id @default(cuid())
  shopifyDomain      String          @unique
  accessToken        String
  name               String?
  ownerEmail         String?
  ownerPhone         String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  country            String          @default("PAK")
  enableMultiCountry Boolean         @default(false)
  supportedCountries Json            @default("[]")
  setupProgress      Json?           @default("{\"step1Completed\": false, \"step2Completed\": false, \"welcomeDismissed\": false, \"setupGuideDismissed\": false}")
  themeEmbedEnabled   Boolean?
  themeEmbedCheckedAt DateTime?
  tokenInvalid        Boolean   @default(false)  // Set true when Shopify returns 401 — skip in cron
  abandonedCarts     AbandonedCart[]
  downsells          Downsell[]
  formConfig         FormConfig?
  orders             Order[]
  orderSessions      OrderSession[]
  pixels             Pixel[]
  settings           Settings?
  shippingRates      ShippingRate[]
  upsells            Upsell[]
  subscription       Subscription?
  blockedUsers       BlockedUser[]
  bundles            Bundle[]
  googleSheets       GoogleSheetsIntegration?
}

model GoogleSheetsIntegration {
  id                      String    @id @default(cuid())
  shopId                  String    @unique
  // OAuth
  googleEmail             String?
  accessToken             String?   // short-lived; refreshed as needed
  refreshToken            String?   // long-lived (offline access)
  tokenExpiry             DateTime?
  // Target
  enabled                 Boolean   @default(false)
  spreadsheetId           String?
  spreadsheetName         String?
  ordersSheetName         String?   @default("ALL") // tab for normal orders
  abandonedSheetName      String?   // separate tab; null = disabled
  importAbandonedSeparate Boolean   @default(false)
  orderTypeFilter         String    @default("normal") // "normal" | "abandoned" | "both"
  oneProductPerLine       Boolean   @default(false)
  // Mapping: ordered array of column configs, e.g.
  // [{ "col": "A", "field": "order_number" }, { "col": "B", "field": "custom_text", "value": "..." }]
  columnMapping           Json      @default("[]")
  // Incremental cursors ("only new orders")
  lastSyncedOrderAt       DateTime?
  lastSyncedAbandonedAt   DateTime?
  lastSyncError           String?
  lastSyncedAt            DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  shop                    Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                 String    @id @default(cuid())
  shopId             String    @unique
  mantleCustomerId   String?
  planId             String?
  planName           String?
  status             String    @default("trialing")
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  trialEndsAt        DateTime?
  usageCharges       Json      @default("[]")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  shop               Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([status])
}

model Settings {
  id                   String   @id @default(cuid())
  shopId               String   @unique
  formMode             String   @default("popup")
  buttonText           String   @default("Buy with Cash on Delivery")
  buttonBgColor        String   @default("rgba(0,0,0,1)")
  buttonTextColor      String   @default("rgba(255,255,255,1)")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  buttonAnimation      String   @default("none")
  buttonBorderColor    String   @default("#000000")
  buttonBorderRadius   Int      @default(4)
  buttonBorderWidth    Int      @default(0)
  buttonFontSize       Int      @default(16)
  buttonIcon           String   @default("cart")
  buttonShadow         Int      @default(4)
  allowCartItems       Boolean  @default(true)
  enableRTL            Boolean  @default(false)
  buttonPageVisibility String   @default("both")
  hideAddToCartButton  Boolean  @default(false)
  hideBuyNowButton     Boolean  @default(false)
  hideCheckoutButton   Boolean  @default(false)
  enableCartPermalink  Boolean  @default(false)
  hideCompleteOrderButton Boolean @default(false)
  cardButtonText       String   @default("PAY WITH CARD")
  cardButtonBgColor    String   @default("#FFFFFF")
  cardButtonTextColor  String   @default("#000000")
  cardButtonFontSize   Int      @default(14)
  cardDiscountEnabled  Boolean  @default(false)
  cardDiscountType     String   @default("percentage")
  cardDiscountValue    Float    @default(0)
  allowDiscountOnBundles Boolean @default(true)
  enableOTP            Boolean  @default(false)
  enableSmartCheckout  Boolean  @default(false)
  language             String   @default("en")
  enableSpecificProducts Boolean @default(false)
  specificProductIds   Json     @default("[]")
  specificProductTitles Json    @default("[]")
  disableSpecificProducts Boolean @default(false)
  disabledProductIds   Json     @default("[]")
  disabledProductTitles Json    @default("[]")
  // Country restriction — only show the COD form to visitors in allowed countries
  enableCountryRestriction Boolean @default(false)
  allowedCountries         Json    @default("[]") // array of ISO alpha-2 codes, e.g. ["PK","AE"]
  enableUserBlocking   Boolean  @default(false)
  blockedUserMessage   String   @default("You are not allowed to place orders. Please contact support.")
  // Fraud prevention — order rate limit & high-quantity block
  limitOrdersEnabled        Boolean @default(false)
  limitOrdersWindowMinutes  Int     @default(1440) // default 24h
  blockHighQuantityEnabled  Boolean @default(false)
  maxQuantityPerOrder       Int     @default(10)
  // Sticky page bar (mobile) — opens the COD form
  stickyBarEnabled          Boolean @default(false)
  stickyBarPosition         String  @default("bottom") // bottom | top
  stickyBarAlwaysVisible    Boolean @default(true)
  // PayFast configuration
  payfastEnabled        Boolean  @default(false)
  payfastMerchantId     String?
  payfastSecuredKey     String?
  payfastButtonText     String   @default("PAY WITH PAYFAST")
  payfastButtonBgColor  String   @default("#00B140")
  payfastButtonTextColor String  @default("#FFFFFF")
  payfastButtonFontSize Int      @default(14)
  // Post-order redirection (COD)
  redirectMode            String   @default("shopify") // shopify | custom_page | whatsapp | none
  redirectUrl             String?
  redirectWhatsappNumber  String?
  redirectWhatsappMessage String?
  thankYouMessage         String?
  // Free shipping progress nudge
  freeShippingNudgeEnabled     Boolean @default(false)
  freeShippingNudgeAmountText  String  @default("🚚 Add {{amount}} more to get free delivery")
  freeShippingNudgeQtyText     String  @default("🚚 Add {{count}} more item(s) to get free delivery")
  freeShippingNudgeSuccessText String  @default("🎉 You've unlocked free delivery!")
  shop                 Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model FormConfig {
  id                     String   @id @default(cuid())
  shopId                 String   @unique
  formTitle              String   @default("CASH ON DELIVERY")
  textColor              String   @default("rgba(0,0,0,1)")
  backgroundColor        String   @default("rgba(255,255,255,1)")
  fontSize               Int      @default(14)
  borderRadius           Int      @default(8)
  borderWidth            Int      @default(1)
  borderColor            String   @default("rgba(0,0,0,0.1)")
  shadowIntensity        Int      @default(5)
  sections               Json     @default("[]")
  fields                 Json     @default("[]")
  requiredFieldErrorText   String   @default("This field is required.")
  invalidFieldErrorText    String   @default("Enter a valid value.")
  submitButtonText         String   @default("")
  submitButtonBgColor      String   @default("rgba(0,0,0,1)")
  submitButtonTextColor    String   @default("rgba(255,255,255,1)")
  submitButtonFontSize     Int      @default(14)
  submitButtonIcon         String   @default("none")
  formTitleAlign           String   @default("left") // left | center | right
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  shop                     Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model Order {
  id                 String   @id @default(cuid())
  shopId             String
  shopifyOrderId     String?  @unique
  shopifyOrderNumber String?
  firstName          String
  lastName           String
  email              String?
  phone              String
  address            String
  address2           String?
  city               String
  province           String
  postalCode         String?
  country            String   @default("Pakistan")
  subtotal           Float
  shipping           Float    @default(0)
  total              Float
  customFields       Json     @default("{}")
  items              Json
  status             String   @default("pending")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  paymentMethod      String   @default("cod")
  fulfillmentStatus  String?    // Raw Shopify FulfillmentDisplayStatus value
  deliveryOutcome    String?    // Mapped: "delivered" | "returned" | "cancelled" | "in_transit" | "unfulfilled"
  fulfillmentSyncedAt DateTime? // Last time cron checked this order
  riskLevel          String?    // "LOW" | "MEDIUM" | "HIGH" | null (set at creation)
  verificationMethod  String?
  shop               Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([status])
  @@index([createdAt])
  @@index([deliveryOutcome])
  @@index([phone])
}

model OrderSession {
  id             String    @id @default(cuid())
  shopId         String
  sessionId      String    @unique
  userEmail      String?
  userPhone      String?
  cartItems      String
  totalAmount    Float     @default(0)
  formData       String?
  startedAt      DateTime  @default(now())
  lastActivityAt DateTime  @default(now())
  completedAt    DateTime?
  abandonedAt    DateTime?
  status         String    @default("active")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  shop           Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([sessionId])
  @@index([status])
  @@index([startedAt])
}

model AbandonedCart {
  id                  String    @id @default(cuid())
  shopId              String
  sessionId           String    @unique
  customerEmail       String?
  customerPhone       String?
  customerFirstName   String?
  customerLastName    String?
  cartItems           String
  totalAmount         Float     @default(0)
  shopifyDraftOrderId String?
  draftOrderUrl       String?
  abandonedAt         DateTime  @default(now())
  recovered           Boolean   @default(false)
  recoveredAt         DateTime?
  recoveredOrderId    String?
  retryCount          Int       @default(0)
  lastFailedAt        DateTime?
  lastError           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  shop                Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([sessionId])
  @@index([abandonedAt])
  @@index([recovered])
}

model CronLog {
  id        String   @id @default(cuid())
  jobName   String
  status    String
  message   String?
  processed Int      @default(0)
  errors    Int      @default(0)
  duration  Int?
  createdAt DateTime @default(now())

  @@index([jobName, createdAt])
}

model Upsell {
  id                     String   @id @default(cuid())
  shopId                 String
  name                   String   @default("My Upsell")
  priority               Int      @default(1)
  upsellType             String   @default("pre-purchase")
  enabled                Boolean  @default(false)
  productId              String?
  productTitle           String?
  productImage           String?
  productPrice           Float?
  variantId              String?
  discountType           String   @default("none")
  discountValue          Float    @default(0)
  modalTitle             String   @default("Add {product_name} to your order!")
  acceptButtonText       String   @default("Add to my order")
  declineButtonText      String   @default("No thank you, complete my order")
  acceptButtonBgColor    String   @default("#000000")
  acceptButtonTextColor  String   @default("#ffffff")
  declineButtonBgColor   String   @default("#ffffff")
  declineButtonTextColor String   @default("#000000")
  impressions            Int      @default(0)
  accepts                Int      @default(0)
  declines               Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  backgroundColor        String?
  borderColor            String?
  borderRadius           Int?
  borderStyle            String?
  borderWidth            Int?
  checkboxText           String?
  descriptionColor       String?
  descriptionText        String?
  imageUrl               String?
  preselectUpsell        Boolean  @default(false)
  textColor              String?
  upsellPrice            Float?
  upsellTitle            String?
  shop                   Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([shopId, upsellType, enabled])
  @@index([priority])
}

model Downsell {
  id                       String   @id @default(cuid())
  shopId                   String
  name                     String   @default("New downsell")
  priority                 Int      @default(1)
  enabled                  Boolean  @default(false)
  showCount                Int      @default(1)
  disableOtherDiscounts    Boolean  @default(false)
  discountType             String   @default("percentage")
  discountValue            Float    @default(10)
  title                    String   @default("Wait!")
  titleColor               String   @default("rgba(0,0,0,1)")
  titleFontSize            Int      @default(13)
  subtitle                 String   @default("We have an offer for you!")
  subtitleColor            String   @default("rgba(45,45,45,1)")
  subtitleFontSize         Int      @default(13)
  plaqueText               String   @default("GET AN EXTRA DISCOUNT ON YOUR ORDER:")
  plaqueTextColor          String   @default("rgba(0,0,0,1)")
  plaqueBackgroundColor    String   @default("#EF4444")
  plaqueGradientEndColor   String   @default("#FF1493")
  plaqueDiscountColor      String   @default("rgba(255,255,255,1)")
  plaqueSize               Int      @default(50)
  ctaText                  String   @default("Do you want to complete your order?")
  ctaTextColor             String   @default("rgba(0,0,0,1)")
  acceptButtonText         String   @default("COMPLETE ORDER WITH {discount} OFF")
  acceptButtonAnimation    String   @default("none")
  acceptButtonIcon         String   @default("none")
  acceptButtonBgColor      String   @default("linear-gradient(90deg, #ff6b6b, #ee5a5a)")
  acceptButtonTextColor    String   @default("rgba(255,255,255,1)")
  acceptButtonFontSize     Int      @default(14)
  acceptButtonRadius       Int      @default(8)
  acceptButtonBorderWidth  Int      @default(0)
  acceptButtonBorderColor  String   @default("rgba(0,0,0,1)")
  acceptButtonShadow       Int      @default(4)
  declineButtonText        String   @default("No thank you")
  declineButtonBgColor     String   @default("rgba(255,255,255,1)")
  declineButtonTextColor   String   @default("rgba(0,0,0,1)")
  declineButtonFontSize    Int      @default(14)
  declineButtonRadius      Int      @default(25)
  declineButtonBorderWidth Int      @default(1)
  declineButtonBorderColor String   @default("rgba(0,0,0,1)")
  declineButtonShadow      Int      @default(0)
  impressions              Int      @default(0)
  accepts                  Int      @default(0)
  declines                 Int      @default(0)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  shop                     Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([shopId, enabled])
  @@index([priority])
}

model Pixel {
  id                     String       @id @default(cuid())
  shopId                 String
  type                   String       // "facebook_pixel" | "facebook_capi" | "snapchat_pixel" | "tiktok_pixel" | "tiktok_events_api"
  label                  String?
  pixelId                String
  accessToken            String?

  // Facebook-specific fields
  purchaseEvent          String       @default("Purchase")
  enableAddToCart        Boolean      @default(false)
  enableAddPaymentInfo   Boolean      @default(false)
  enableInitiateCheckout Boolean      @default(true)

  // Snapchat-specific fields
  enableStartCheckout    Boolean      @default(true)   // START_CHECKOUT event
  enablePurchase         Boolean      @default(true)   // PURCHASE event

  // TikTok-specific fields
  enableTikTokInitiateCheckout Boolean @default(true)  // InitiateCheckout event (pixel only)
  enablePlaceAnOrder            Boolean @default(true)  // PlaceAnOrder event (pixel + API)
  enableCompletePayment         Boolean @default(true)  // CompletePayment event (pixel + API)

  enabled                Boolean      @default(true)
  testMode               Boolean      @default(false)
  testEventCode          String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  shop                   Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  events                 PixelEvent[]

  @@index([shopId])
  @@index([shopId, type, enabled])
}

model PixelEvent {
  id           String   @id @default(cuid())
  pixelId      String
  shopId       String
  eventName    String
  eventId      String
  source       String
  eventData    Json
  status       String   @default("pending")
  responseCode Int?
  errorMessage String?
  fbclid       String?
  fbp          String?
  fbc          String?
  orderId      String?
  orderNumber  String?
  createdAt    DateTime @default(now())
  pixel        Pixel    @relation(fields: [pixelId], references: [id], onDelete: Cascade)

  @@index([pixelId])
  @@index([shopId])
  @@index([eventName])
  @@index([createdAt])
  @@index([orderId])
}

model CustomerProfile {
  id              String       @id @default(cuid())
  shopId          String
  phone           String
  firstName       String?
  lastName        String?
  email           String?
  address         String?
  address2        String?
  city            String?
  province        String?
  postalCode      String?
  countryCode     String       @default("PAK")
  totalOrders     Int          @default(0)
  completedOrders Int          @default(0)
  rtoOrders       Int          @default(0)
  rtoRate         Float        @default(0)
  riskScore       String       @default("UNKNOWN")
  isBlacklisted   Boolean      @default(false)
  firstOrderAt    DateTime?
  lastOrderAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  otpSessions     OTPSession[]

  @@unique([shopId, phone])
  @@index([shopId])
  @@index([phone])
}

model OTPSession {
  id          String           @id @default(cuid())
  shopId      String
  phone       String
  otp         String
  verified    Boolean          @default(false)
  expiresAt   DateTime
  attempts    Int              @default(0)
  channel    String           @default("whatsapp")
  createdAt   DateTime         @default(now())
  customerId  String?
  customer    CustomerProfile? @relation(fields: [customerId], references: [id])

  @@index([shopId, phone])
  @@index([expiresAt])
}

// ============================================
// GLOBAL BUYER IDENTITY (Cross-Merchant Network)
// ============================================

model GlobalBuyer {
  id                     String             @id @default(cuid())
  phone                  String             @unique
  firstName              String?
  lastName               String?
  email                  String?
  whatsappVerified       Boolean            @default(false)
  totalOrdersGlobal      Int                @default(0)
  lastVerifiedAt         DateTime?
  preferredPaymentMethod String?            // "cod" | "card" — last used payment method
  lastCity               String?            // Last used city for smart defaults
  lastProvince           String?            // Last used province for smart defaults
  deliveredOrdersGlobal  Int                @default(0)
  rtoOrdersGlobal        Int                @default(0)
  cancelledOrdersGlobal  Int                @default(0)
  rtoRateGlobal          Float              @default(0)
  riskScoreGlobal        String             @default("UNKNOWN")  // "LOW" | "MEDIUM" | "HIGH" | "UNKNOWN"
  lastRiskCalculatedAt   DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  addresses              BuyerAddress[]
  shopProfiles           ShopBuyerProfile[]

  @@index([phone])
}

model BuyerAddress {
  id          String      @id @default(cuid())
  buyerId     String
  label       String      @default("Home")
  address     String
  address2    String?
  city        String
  province    String
  postalCode  String?
  country     String      @default("Pakistan")
  countryCode String      @default("PAK")
  isDefault   Boolean     @default(true)
  lastUsedAt  DateTime    @default(now())
  usageCount  Int         @default(1)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  buyer       GlobalBuyer @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([buyerId])
  @@index([buyerId, lastUsedAt])
}

model ShopBuyerProfile {
  id              String      @id @default(cuid())
  shopId          String
  buyerId         String
  totalOrders     Int         @default(0)
  completedOrders Int         @default(0)
  rtoOrders       Int         @default(0)
  rtoRate         Float       @default(0)
  riskScore       String      @default("UNKNOWN")
  isBlacklisted   Boolean     @default(false)
  firstOrderAt    DateTime?
  lastOrderAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  buyer           GlobalBuyer @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@unique([shopId, buyerId])
  @@index([shopId])
  @@index([buyerId])
}

model WhatsAppLoginSession {
  id         String    @id @default(cuid())
  token      String    @unique
  phone      String
  status     String    @default("pending") // "pending" | "verified" | "expired"
  verifiedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([token])
  @@index([phone, status])
  @@index([expiresAt])
}

model ShippingRate {
  id                    String   @id @default(cuid())
  shopId                String
  name                  String   @default("Standard Shipping")
  description           String?
  price                 Float    @default(0)
  enabled               Boolean  @default(true)
  priority              Int      @default(1)
  conditions            Json     @default("[]")
  shopifyShippingRateId String?
  isShopifyImported     Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  shop                  Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, shopifyShippingRateId])
  @@index([shopId])
  @@index([shopId, enabled])
  @@index([priority])
}

model BlockedUser {
  id        String   @id @default(cuid())
  shopId    String
  type      String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, type, value])
  @@index([shopId, type])
}

model Bundle {
  id                String   @id @default(cuid())
  shopId            String
  name              String   @default("My Bundle Offer")
  priority          Int      @default(1)
  enabled           Boolean  @default(false)
  status            String   @default("draft")

  // Display
  headerText        String   @default("Buy More Save More")
  hideHeaderLines   Boolean  @default(false)

  // Product Targeting
  applyOn           String   @default("all")
  productIds        Json     @default("[]")
  productTitles     Json     @default("[]")
  collectionIds     Json     @default("[]")
  collectionTitles  Json     @default("[]")

  // Basic Setup
  allowVariantMix   Boolean  @default(false)
  hideThemeVariants  Boolean  @default(false)
  volumeDiscount     Boolean  @default(false)
  showStockWarning   Boolean  @default(true)

  // Tiers (JSON array)
  tiers             Json     @default("[]")

  // Styling (JSON object)
  styling           Json     @default("{}")

  // Stats
  impressions       Int      @default(0)
  accepts           Int      @default(0)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  shop              Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([shopId, status])
  @@index([priority])
}

// ============================================
// DEVICE FINGERPRINTING (One-Tap Checkout)
// ============================================

model DeviceFingerprint {
  id            String   @id @default(cuid())
  fingerprintId String   // ThumbmarkJS hash
  phone         String   // Normalized phone (e.g., +923240310716)
  lastSeenAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([fingerprintId, phone])
  @@index([fingerprintId])
  @@index([phone])
}

model FulfillmentSyncCursor {
  id           String   @id @default(cuid())
  shopId       String   @unique
  lastSyncedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============================================
// EXTERNAL DELIVERY RECORDS (Cross-App Pipeline)
// ============================================

model ExternalDeliveryRecord {
  id               String   @id @default(cuid())
  phone            String   // Normalized phone — matches GlobalBuyer.phone
  sourceApp        String   // "courierify" | "financify" (future)
  sourceShopDomain String   // The shop this shipment belongs to
  externalId       String   // Source record ID — used for deduplication
  deliveryOutcome  String   // "delivered" | "returned" | "cancelled" | "in_transit" | "booked"
  orderValue       Decimal? @db.Decimal(10, 2)
  createdAt        DateTime @default(now())
  syncedAt         DateTime @default(now())

  @@unique([sourceApp, externalId])
  @@index([phone])
  @@index([phone, deliveryOutcome])
  @@index([sourceApp, sourceShopDomain])
}
