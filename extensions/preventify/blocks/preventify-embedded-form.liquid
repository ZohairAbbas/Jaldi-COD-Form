{% schema %}
{
  "name": "Preventify - COD Form",
  "target": "section",
  "enabled_on": {
    "templates": ["product", "cart"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Manually place the embedded COD form at this exact position. This overrides the default position. Configure your form in the app admin panel."
    }
  ]
}
{% endschema %}

{% comment %}
  Manual Embedded Form Block
  Available on product and cart pages
  Marks the page as having a manual embedded block to prevent default rendering
{% endcomment %}

{% if template.name == 'product' %}
  <div id="preventify-embedded-manual"
       data-preventify-manual-embedded
       data-shop="{{ shop.permanent_domain }}"
       data-product-id="{{ product.id }}"
       data-variant-id="{{ product.selected_or_first_available_variant.id }}"
       data-product-title="{{ product.title | escape }}"
       data-variant-title="{{ product.selected_or_first_available_variant.title | escape }}"
       data-product-price="{{ product.selected_or_first_available_variant.price | divided_by: 100.0 }}"
       data-product-image="{{ product.featured_image | image_url: width: 100 }}">
  </div>
{% elsif template.name == 'cart' %}
  <div id="preventify-embedded-manual"
       data-preventify-manual-embedded
       data-shop="{{ shop.permanent_domain }}">
  </div>
{% endif %}

<script src="https://unpkg.com/react@18/umd/react.production.min.js" crossorigin></script>
<script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js" crossorigin></script>
<link rel="stylesheet" href="{{ 'preventify.css' | asset_url }}?v={{ 'now' | date: '%s' }}">
<script src="{{ 'preventify.js' | asset_url }}?v={{ 'now' | date: '%s' }}" defer></script>
