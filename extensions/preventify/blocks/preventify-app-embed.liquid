{% schema %}
{
  "name": "Preventify COD Form",
  "target": "body",
  "settings": [
    {
      "type": "paragraph",
      "content": "Enable this to show COD form on your store. Control mode (popup/embedded) and page visibility from Preventify app settings."
    },
    {
      "type": "text",
      "id": "app_path",
      "label": "App Path",
      "default": "/apps/preventify/",
      "info": "Leave as default unless using staging version (/apps/preventify-staging/)"
    }
  ]
}
{% endschema %}

{% comment %}
  App Embed Block - Loads on all pages for cart drawer support
  Main button/form only renders on product/cart pages based on settings
{% endcomment %}

{% comment %} Always load scripts for cart drawer popup support {% endcomment %}
<script src="https://unpkg.com/react@18/umd/react.production.min.js" crossorigin></script>
<script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js" crossorigin></script>
<link rel="stylesheet" href="{{ 'preventify.css' | asset_url }}?v={{ 'now' | date: '%s' }}">
<script>
  {% assign raw_app_path = block.settings.app_path | default: "/apps/preventify/" %}
  {% if raw_app_path contains 'staging' %}
    window.PREVENTIFY_APP_PATH = '/apps/preventify-staging/';
  {% else %}
    window.PREVENTIFY_APP_PATH = '/apps/preventify/';
  {% endif %}
  {% if template.name == 'product' %}
  window.PREVENTIFY_VARIANT_INVENTORY = {
    {% for variant in product.variants %}
      "{{ variant.id }}": { "quantity": {{ variant.inventory_quantity | default: 0 }}, "policy": "{{ variant.inventory_policy }}", "tracked": {% if variant.inventory_management == 'shopify' %}true{% else %}false{% endif %} }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  };
  {% endif %}
</script>
<script src="{{ 'preventify.js' | asset_url }}?v={{ 'now' | date: '%s' }}" defer></script>

{% comment %} Only render app embed container on product/cart pages {% endcomment %}
{% if template.name == 'product' or template.name == 'cart' %}
  <div id="preventify-app-embed"
       data-preventify-app-embed
       data-shop="{{ shop.permanent_domain }}"
       data-app-path="{% if raw_app_path contains 'staging' %}/apps/preventify-staging/{% else %}/apps/preventify/{% endif %}"
       data-page-type="{{ template.name }}"
       {% if template.name == 'product' %}
         data-product-id="{{ product.id }}"
         data-variant-id="{{ product.selected_or_first_available_variant.id }}"
         data-product-title="{{ product.title | escape }}"
         data-variant-title="{{ product.selected_or_first_available_variant.title | escape }}"
         data-product-price="{{ product.selected_or_first_available_variant.price | divided_by: 100.0 }}"
         {% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}
           data-compare-at-price="{{ product.selected_or_first_available_variant.compare_at_price | divided_by: 100.0 }}"
         {% endif %}
         data-product-image="{{ product.featured_image | image_url: width: 100 }}"
         data-inventory-quantity="{{ product.selected_or_first_available_variant.inventory_quantity }}"
         data-inventory-policy="{{ product.selected_or_first_available_variant.inventory_policy }}"
       {% endif %}
       style="display: none;">
  </div>
{% endif %}
